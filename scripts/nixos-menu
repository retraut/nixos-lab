#!/usr/bin/env bash
set -euo pipefail

menu_pid="$(pgrep -f "^quickshell -n -p $HOME/.config/quickshell/menu.qml$" | head -n 1 || true)"
if [[ -n "$menu_pid" ]]; then
  quickshell ipc --pid "$menu_pid" call nixos-menu close >/dev/null 2>&1 || true
  exit 0
fi

exec quickshell -n -p "$HOME/.config/quickshell/menu.qml"
