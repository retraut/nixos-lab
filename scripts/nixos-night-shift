#!/bin/sh
set -eu

cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/nixos-night-shift"
location_file="$cache_dir/location"
mkdir -p "$cache_dir"

# The weather widget already uses this coarse IP geolocation source. Cache the
# last successful result so a temporary network outage does not disable night
# mode after the session starts.
location="$(curl -fsS --max-time 10 https://ipinfo.io/loc 2>/dev/null | tr -d '\r\n' || true)"
if [ -z "$location" ] && [ -s "$location_file" ]; then
  location="$(tr -d '\r\n' < "$location_file")"
fi

case "$location" in
  *,*) : ;;
  *)
    echo "Could not determine display location" >&2
    exit 1
    ;;
esac

printf '%s\n' "$location" > "$location_file"

latitude=${location%%,*}
longitude=${location#*,}

# wlsunset calculates sunrise/sunset locally and smoothly transitions between
# daylight and night temperatures through the Wayland gamma protocol.
exec wlsunset -l "$latitude" -L "$longitude" -T 6500 -t 4000
