#!/usr/bin/env python3
import glob
import json
import os
import shutil
import subprocess
import time

def cpu_usage():
    def read():
        with open("/proc/stat") as f:
            values = [int(value) for value in f.readline().split()[1:]]
        return sum(values), values[3] + values[4]
    total1, idle1 = read(); time.sleep(0.08); total2, idle2 = read()
    delta = total2 - total1 or 1
    return round(100 * (delta - (idle2 - idle1)) / delta)

def memory_info():
    values = {}
    with open("/proc/meminfo") as f:
        for line in f:
            key, value = line.split(":", 1); values[key] = int(value.split()[0])
    total = values.get("MemTotal", 0); used = total - values.get("MemAvailable", total)
    swap_total = values.get("SwapTotal", 0); swap_used = swap_total - values.get("SwapFree", 0)
    return {"percent": round(100 * used / total) if total else 0,
            "swapPercent": round(100 * swap_used / swap_total) if swap_total else 0}

def temperature():
    for path in glob.glob("/sys/class/hwmon/hwmon*/temp1_input"):
        try:
            chip = open(os.path.join(os.path.dirname(path), "name")).read().strip()
            if chip in ("coretemp", "k10temp", "zenpower", "cpu_thermal"):
                return round(int(open(path).read()) / 1000)
        except (OSError, ValueError): pass
    for path in glob.glob("/sys/class/hwmon/hwmon*/temp1_input"):
        try: return round(int(open(path).read()) / 1000)
        except (OSError, ValueError): pass
    return 0

def top_processes(power):
    ignored = {"awk", "bash", "dash", "head", "ps", "python3", "sed", "sh", "sort", "tail"}
    by_name = {}
    try:
        output = subprocess.run(
            ["ps", "-eo", "comm=,pcpu="], capture_output=True, text=True, check=True
        ).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    for line in output.splitlines():
        parts = line.split()
        if len(parts) < 2 or parts[0] in ignored:
            continue
        try: cpu = float(parts[-1])
        except ValueError: continue
        by_name[parts[0]] = by_name.get(parts[0], 0.0) + cpu
    total_cpu = sum(by_name.values()) or 1.0
    rows = []
    for name, cpu in sorted(by_name.items(), key=lambda item: item[1], reverse=True)[:4]:
        rows.append({
            "name": name,
            "cpu": round(cpu, 1),
            "w": round(power * cpu / total_cpu, 1) if power is not None else None,
        })
    return rows

power = None
for path in glob.glob("/sys/class/power_supply/BAT*/power_now"):
    try: power = round(int(open(path).read()) / 1_000_000, 1); break
    except (OSError, ValueError): pass

usage = shutil.disk_usage("/")
capabilities = {
    "wifi": bool(glob.glob("/sys/class/net/wl*")),
    "bluetooth": bool(glob.glob("/sys/class/bluetooth/hci*")),
    "backlight": bool(glob.glob("/sys/class/backlight/*")),
    "battery": bool(glob.glob("/sys/class/power_supply/BAT*")),
    "tailscale": shutil.which("tailscale") is not None,
}
print(json.dumps({"cpu": cpu_usage(), "mem": memory_info(), "temp": temperature(),
                  "storage": round(100 * usage.used / usage.total), "power": power,
                  "topProcesses": top_processes(power), "capabilities": capabilities}))
