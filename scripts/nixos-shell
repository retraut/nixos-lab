#!/bin/sh
export HYPRLAND_INSTANCE_SIGNATURE="${HYPRLAND_INSTANCE_SIGNATURE:-$(hyprctl instances -j 2>/dev/null | jq -r '.[0].instance // empty')}"

# Keep the calendar QML process warm but hidden; the bar invokes it through
# Quickshell IPC, avoiding a visible cold-start delay on every click.
calendar_config="$HOME/.config/quickshell/calendar.qml"
quickshell -n -p "$calendar_config" >/tmp/nixos-calendar.log 2>&1 &

exec quickshell -n -p "$HOME/.config/quickshell/shell.qml"
