#!/usr/bin/env bash
set -euo pipefail

launcher="$HOME/.config/quickshell/app-launcher.qml"

if quickshell ipc --path "$launcher" call nixos-launcher toggle >/dev/null 2>&1; then
  exit 0
fi

# The normal path keeps this process warm from session startup. This fallback
# also makes the first hotkey work if the warm instance is still starting.
NIXOS_LAUNCHER_OPEN=1 exec quickshell -n -p "$launcher"
