#!/usr/bin/env python3
"""Collect Codex usage from native session JSONL files.

The collector is deliberately independent from Omarchy. Codex writes
token_count events into ~/.codex/sessions; this command reduces those events
to the JSON shape consumed by the Quickshell Agents panel.
"""

from __future__ import annotations

import datetime as dt
import json
import os
from pathlib import Path
from typing import Any


def number(value: Any) -> int:
    try:
        return max(0, round(float(value or 0)))
    except (TypeError, ValueError):
        return 0


def local_day(value: Any) -> str:
    if isinstance(value, (int, float)):
        timestamp = float(value)
        if timestamp > 10_000_000_000:
            timestamp /= 1000
        return dt.datetime.fromtimestamp(timestamp).date().isoformat()
    raw = str(value or "")
    try:
        return dt.datetime.fromisoformat(raw.replace("Z", "+00:00")).astimezone().date().isoformat()
    except (TypeError, ValueError):
        return dt.datetime.now().date().isoformat()


def iso_timestamp(value: Any) -> str:
    if isinstance(value, (int, float)):
        return dt.datetime.fromtimestamp(float(value), dt.timezone.utc).isoformat()
    return str(value or "")


def empty_bucket() -> dict[str, int]:
    return {
        "inputTokens": 0,
        "outputTokens": 0,
        "cacheReadInputTokens": 0,
        "cacheCreationInputTokens": 0,
    }


def find_model(value: Any) -> str:
    if isinstance(value, dict):
        for key in ("model", "model_name", "model_slug"):
            candidate = value.get(key)
            if isinstance(candidate, str) and candidate and not candidate.startswith("model_"):
                return candidate
        for child in value.values():
            found = find_model(child)
            if found:
                return found
    elif isinstance(value, list):
        for child in value:
            found = find_model(child)
            if found:
                return found
    return "codex"


def session_record(path: Path) -> dict[str, Any] | None:
    latest: dict[str, Any] | None = None
    model = "codex"
    prompt_count = 0
    try:
        with path.open("r", encoding="utf-8", errors="replace") as stream:
            for line in stream:
                try:
                    entry = json.loads(line)
                except json.JSONDecodeError:
                    continue

                candidate = find_model(entry)
                if candidate != "codex":
                    model = candidate

                if entry.get("type") != "event_msg":
                    continue
                payload = entry.get("payload") or {}
                if payload.get("type") != "token_count":
                    continue
                info = payload.get("info") or {}
                usage = info.get("total_token_usage") or {}
                total = number(usage.get("total_tokens"))
                if total <= 0:
                    continue
                prompt_count += 1
                latest = {
                    "timestamp": entry.get("timestamp"),
                    "day": local_day(entry.get("timestamp")),
                    "total": total,
                    "input": number(usage.get("input_tokens")),
                    "output": number(usage.get("output_tokens")),
                    "cacheRead": number(usage.get("cached_input_tokens")),
                    "cacheWrite": number(usage.get("cache_write_input_tokens")),
                    "rateLimits": payload.get("rate_limits") or {},
                }
    except OSError:
        return None

    if latest is None:
        return None
    latest["model"] = model
    latest["prompts"] = prompt_count
    latest["session"] = str(path)
    return latest


def format_limit(rate_limits: dict[str, Any]) -> list[dict[str, Any]]:
    primary = rate_limits.get("primary") or {}
    if not isinstance(primary, dict) or primary.get("used_percent") is None:
        return []
    used = float(primary.get("used_percent") or 0)
    if used > 1:
        used /= 100
    minutes = number(primary.get("window_minutes"))
    title = "Weekly" if minutes >= 7 * 24 * 60 else "Session"
    reset = primary.get("resets_at")
    return [{
        "title": title,
        "percent": max(0, min(1, used)),
        "resetsAt": iso_timestamp(reset) if reset else "",
    }]


def main() -> None:
    now = dt.datetime.now().date()
    recent_days = [(now - dt.timedelta(days=offset)).isoformat() for offset in range(6, -1, -1)]
    records: list[dict[str, Any]] = []
    root = Path(os.environ.get("CODEX_SESSIONS_DIR", Path.home() / ".codex" / "sessions"))
    if root.is_dir():
        for path in root.rglob("*.jsonl"):
            record = session_record(path)
            if record:
                records.append(record)

    records.sort(key=lambda item: str(item.get("timestamp") or ""))
    recent = {day: 0 for day in recent_days}
    model_usage: dict[str, dict[str, int]] = {}
    active_dates: set[str] = set()
    today_prompts = 0
    today_sessions: set[str] = set()
    today_total_tokens = 0
    total_prompts = 0
    total_sessions: set[str] = set()
    latest_limits: dict[str, Any] = {}
    latest_plan = ""

    for record in records:
        day = str(record["day"])
        total = number(record["total"])
        active_dates.add(day)
        total_sessions.add(str(record["session"]))
        total_prompts += number(record["prompts"])
        if day in recent:
            recent[day] += total
        if day == now.isoformat():
            today_prompts += number(record["prompts"])
            today_sessions.add(str(record["session"]))
            today_total_tokens += total

        model = str(record.get("model") or "codex")
        bucket = model_usage.setdefault(model, empty_bucket())
        bucket["inputTokens"] += number(record["input"])
        bucket["outputTokens"] += number(record["output"])
        bucket["cacheReadInputTokens"] += number(record["cacheRead"])
        bucket["cacheCreationInputTokens"] += number(record["cacheWrite"])

        if record.get("rateLimits"):
            latest_limits = record["rateLimits"]
            latest_plan = str((latest_limits.get("plan_type") or "")).lower()

    latest = records[-1] if records else None
    record = {
        "schemaVersion": 1,
        "id": "codex",
        "name": "Codex",
        "updatedAt": dt.datetime.now(dt.timezone.utc).isoformat(),
        "ready": bool(records),
        "hasLocalStats": bool(records),
        "tierLabel": latest_plan or "",
        "usageStatusText": "" if records else "No Codex usage data found",
        "authHelpText": "Run `codex login` to authenticate.",
        "todayPrompts": today_prompts,
        "todaySessions": len(today_sessions),
        "todayTotalTokens": today_total_tokens,
        "recentDays": [{"date": day, "messageCount": recent[day]} for day in recent_days],
        "totalPrompts": total_prompts,
        "totalSessions": len(total_sessions),
        "activeDays": len(active_dates),
        "activeDates": sorted(active_dates),
        "modelUsage": model_usage,
        "limits": format_limit(latest_limits),
    }
    if latest and not record["tierLabel"]:
        record["tierLabel"] = "Subscription"
    print(json.dumps(record, separators=(",", ":")))


if __name__ == "__main__":
    main()
