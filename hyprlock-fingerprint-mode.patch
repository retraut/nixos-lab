+void CPasswordInputField::shakeTimerCallback(AWP<CPasswordInputField> ref) {
+    const auto SELF = ref.lock();
+    if (!SELF)
+        return;
+
+    SELF->shakeTimer = nullptr;
+    if (!SELF->displayFail || !SELF->fingerprintMode) {
+        SELF->shakePhase = 0;
+        g_pHyprlock->renderAllOutputs();
+        return;
+    }
+
+    ++SELF->shakePhase;
+    if (SELF->shakePhase < 10)
+        SELF->shakeTimer = g_pHyprlock->addTimer(std::chrono::milliseconds(35), [REF = ref](auto, auto) { CPasswordInputField::shakeTimerCallback(REF); }, nullptr);
+    else
+        SELF->shakePhase = 0;
+
+    g_pHyprlock->renderAllOutputs();
+}
